source 'https://github.com/CocoaPods/Specs.git'

project 'Example.xcodeproj'

target 'ExampleIOS' do
  platform :ios, '14.0'
  use_frameworks!
  pod 'TiRTC', :podspec => 'https://github.com/tangeai/tirtc-sdk-apple/releases/download/v2.6.0-alpha.18/TiRTC.podspec'
end

target 'ExampleMacOS' do
  platform :osx, '11.5'
  use_frameworks!
  pod 'TiRTC', :podspec => 'https://github.com/tangeai/tirtc-sdk-apple/releases/download/v2.6.0-alpha.18/TiRTC.podspec'
end
